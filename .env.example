# Copy to .env and fill in. Never commit .env.
# Set these on Supabase with:  supabase secrets set KEY=value

PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
SITE_URL=https://your-horizon-domain.com

# WhatsApp delivery (optional) — Meta WhatsApp Cloud API
# Needed only if customers choose WhatsApp / Both delivery.
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_ID=1234567890

# Front-end only needs these two (safe to expose; RLS protects the data)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
